# ===================================================
# Muse Electron 生产环境配置
#
# 由 vite mode='production' 自动加载（packaged build 默认 mode）。
# stable / production packaged build 指向正式 *.tabtin.com 域名。
#
# 维护原则：
# - 各类子 collab WS URL **不在这里逐一声明**，由 src/renderer/src/config/api.ts
#   基于 VITE_COLLAB_WS_BASE 自动拼路径。改域名只需要改一处 BASE。
# - VITE_APP_VERSION 不在此声明：production profile 走 package.json#version
#   （由 scripts/run-electron-vite.mjs 自动 fallback；改 release 版本只改 package.json）。
# ===================================================

# ---------- API / Web 入口 ----------
VITE_API_BASE_URL=https://api.example.com
TABTIN_API_BASE_URL=https://api.example.com
VITE_PUBLIC_WEB_BASE_URL=https://web.example.com
TABTIN_PUBLIC_WEB_BASE_URL=https://web.example.com
VITE_WEBSITE_BASE_URL=https://www.example.com
# 注册页协议链接；使用公开 OSS 地址，不附带会过期的临时签名。
VITE_USER_AGREEMENT_URL=https://www.example.com/terms
VITE_PRIVACY_POLICY_URL=https://www.example.com/privacy
VITE_API_TIMEOUT=30000

# SourceMap 上传走 AdminDash 后端域名；脚本会自行拼 /api/client-errors/upload-sourcemap。
SOURCEMAP_API_URL=

# ---------- 协作 WebSocket 基址 ----------
# 6 个子 URL（docs/table/slide/video/design/canvas）由 config/api.ts 用
# `${VITE_COLLAB_WS_BASE}/<path>-collaboration` 拼出，无需在此重复。
VITE_COLLAB_WS_BASE=wss://collab.example.com

# Centrifugo 实时通信（Notification / IM / 业务事件推送）。
# 这一个不能省——子路径 /connection/websocket 是 Centrifugo 协议固定，
# 不在 config/api.ts 的 collab 拼接表里。
VITE_CENTRIFUGO_WS_URL=wss://centrifugo.example.com/connection/websocket

# ---------- 发布期开关 ----------
# Project 正式包保持关闭；IM（消息）已常开，不再设开关。
VITE_ENABLE_PROJECTS_UI=false
# Daemon Control：仅编入底层设备控制能力；“我的设备”等入口由当前组织 + 服务端版本灰度决定。
DAEMON_CONTROL_ENABLED=true
# ChatGPT Codex 账号登录入口：正式包开放（#8853/#8854）。
VITE_ENABLE_OPENAI_CODEX_BYOK_UI=true
# 浏览器容器实现（#6106）：正式包开启 webview。
VITE_TABTIN_BROWSER_CONTAINER=webview

# ---------- Sentry 错误监控（issue #3299，自部署 https://sentry.example.com）----------
# 打包时 Vite 静态注入；environment 由 runtime profile 推导（production→prod）
VITE_SENTRY_DSN=
# sourcemap 上传鉴权（SENTRY_AUTH_TOKEN）只由打包进程环境注入，不写入任何仓库 env 文件。
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
