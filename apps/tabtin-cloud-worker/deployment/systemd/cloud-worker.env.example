# Worker control API must be reachable only from the TabTin control plane.
MUSE_CLOUD_WORKER_HOST=127.0.0.1
MUSE_CLOUD_WORKER_PORT=8090
MUSE_CLOUD_WORKER_TOKEN=replace-with-a-long-random-secret
MUSE_CLOUD_WORKER_PROTOCOL_VERSION=1
MUSE_CLOUD_WORKER_RUNTIME_VERSION=replace-with-the-runtime-image-version
MUSE_CLOUD_RUNTIME_NETWORK=tabtin-cloud-runtime
MUSE_CLOUD_CONTAINER_CLI=/usr/bin/docker
MUSE_CLOUD_STORAGE_QUOTA_MODE=podman-xfs
MUSE_CLOUD_RUNTIME_STORAGE_GB=2
MUSE_CLOUD_RESOURCE_ISOLATION_MODE=cgroup-v2

# Required for production quota enforcement: the dedicated account's rootless
# Podman Docker-compatible socket plus the root-owned XFS quota helper socket.
DOCKER_HOST=unix:///run/user/REPLACE_WITH_MUSE_CLOUD_WORKER_UID/podman/podman.sock
