# Worker control API must be reachable only from the TabTin control plane.
TABTIN_CLOUD_WORKER_HOST=127.0.0.1
TABTIN_CLOUD_WORKER_PORT=8090
TABTIN_CLOUD_WORKER_TOKEN=replace-with-a-long-random-secret
TABTIN_CLOUD_WORKER_PROTOCOL_VERSION=1
TABTIN_CLOUD_WORKER_RUNTIME_VERSION=replace-with-the-runtime-image-version
TABTIN_CLOUD_RUNTIME_NETWORK=tabtin-cloud-runtime
TABTIN_CLOUD_CONTAINER_CLI=/usr/bin/docker
TABTIN_CLOUD_STORAGE_QUOTA_MODE=podman-xfs
TABTIN_CLOUD_RUNTIME_STORAGE_GB=2
TABTIN_CLOUD_RESOURCE_ISOLATION_MODE=cgroup-v2

# Required for production quota enforcement: the dedicated account's rootless
# Podman Docker-compatible socket plus the root-owned XFS quota helper socket.
DOCKER_HOST=unix:///run/user/REPLACE_WITH_TABTIN_CLOUD_WORKER_UID/podman/podman.sock
