{
  "name": "@muse/ws-gateway-client",
  "version": "0.1.0",
  "description": "WebSocket Gateway client SDK for Muse",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "keywords": [
    "muse",
    "gateway",
    "websocket",
    "sdk",
    "client"
  ],
  "author": "Muse Team",
  "license": "MIT",
  "dependencies": {
    "@muse/agent-wire": "workspace:*",
    "@muse/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "vitest": "^1.6.1"
  }
}
