{
  "name": "link-with-target",
  "description": "Link with href and target attributes",
  "pmJson": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Visit " },
          {
            "type": "text",
            "text": "Muse",
            "marks": [{ "type": "link", "attrs": { "href": "https://www.example.com", "target": "_blank" } }]
          },
          { "type": "text", "text": " for more" }
        ]
      }
    ]
  },
  "expectedMarkdown": "Visit [Muse](https://www.example.com) for more"
}
