#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
env_file="${repo_root}/.env"
export COMPOSE_DISABLE_ENV_FILE=1
unset TABTIN_EDITION AUTH_FIXED_VERIFICATION_CODE

usage() {
  echo "Usage: ./community {start|stop|logs}" >&2
  exit 2
}

case "${1:-}" in
  start)
    bash "${repo_root}/scripts/community/ensure-env-file.sh" "${repo_root}"
    bash "${repo_root}/scripts/community/ensure-runtime-image.sh" "${repo_root}"
    docker compose --project-directory "${repo_root}" --env-file "${env_file}" -f "${repo_root}/compose.yaml" up -d --no-build
    echo "Muse Community: http://127.0.0.1:6060"
    echo "Electron: Settings -> Model Configuration -> BYOK"
    ;;
  stop)
    [[ -f "${env_file}" ]] || { echo "Missing ${env_file}; run ./community start first." >&2; exit 1; }
    bash "${repo_root}/scripts/community/ensure-env-file.sh" "${repo_root}"
    docker compose --project-directory "${repo_root}" --env-file "${env_file}" -f "${repo_root}/compose.yaml" down
    ;;
  logs)
    [[ -f "${env_file}" ]] || { echo "Missing ${env_file}; run ./community start first." >&2; exit 1; }
    bash "${repo_root}/scripts/community/ensure-env-file.sh" "${repo_root}"
    docker compose --project-directory "${repo_root}" --env-file "${env_file}" -f "${repo_root}/compose.yaml" logs --follow --tail 200
    ;;
  *)
    usage
    ;;
esac
